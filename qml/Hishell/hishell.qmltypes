import QtQuick.tooling 1.2

Module {
	Component {
		name: "Config"
		defaultProperty: "data"
			prototype: "QObject"
			exports: ["Hishell/Config 1.0"]

			Property { name: "title"; type: "string" }
			Property { name: "icon"; type: "string" }
			Property { name: "wallpaper"; type: "string" }
			Property { name: "top_layout"; type: "string" }
			Property { name: "middle_layout"; type: "string" }
			Property { name: "bottom_layout"; type: "string" }
			Property { name: "header_layout"; type: "string" }
			Property { name: "grid_size"; type: "int" }
			Property { name: "show_labels"; type: "bool" }
			Property { name: "view_mode"; type: "int" }
			Property { name: "sort"; type: "int" }
			Property { name: "sort_date_mode"; type: "int" }
			Property { name: "sort_alpha_mode"; type: "int" }
			Property { name: "stash_shown"; type: "bool" }
			Property { name: "stash_dotfiles"; type: "bool" }
			Property { name: "arbitrary_placement"; type: "bool" }
			Property { name: "arbitrary_positions"; type: "string" }

			Signal { name: "config_changed" }

			Method {
				name: "load"
				Parameter { name: "path"; type: "string" }
			}

			Method {
				name: "set"
				Parameter { name: "path"; type: "string" }
				Parameter { name: "section"; type: "string" }
				Parameter { name: "key"; type: "string" }
				Parameter { name: "value"; type: "string" }
				Parameter { name: "local"; type: "bool" }
			}
	}

	Component {
		name: "Directory"
		defaultProperty: "data"
			prototype: "QObject"
			exports: ["Hishell/Directory 1.0"]

			Property { name: "has_meta"; type: "bool" }
			Property { name: "path"; type: "string" }
			Property { name: "title"; type: "string"}
			Property { name: "config"; type: "Config"}
			Property { name: "icon"; type: "string"}

			Signal { name: "config_changed" }
			Signal { name: "path_changed" }

			Method {
				name: "load_directory"; type: "QStringList"
				Parameter { name: "path"; type: "string"}
				Parameter { name: "include_hidden"; type: "bool"}
			}

			Method {
				name: "row_count"; type: "int";
			}

			Method {
				name: "open_path";
				Parameter { name: "path"; type: "string"}
			}

			Method {
				name: "refresh";
			}

			Method {
				name: "poll_thumbnails";
			}

			Method {
				name: "set_config";
				Parameter { name: "section"; type: "string" }
				Parameter { name: "key"; type: "string" }
				Parameter { name: "value"; type: "string" }
				Parameter { name: "local"; type: "bool" }
			}
	}

	Component {
		name: "FileManager"
		defaultProperty: "data"
			prototype: "QObject"
			exports: ["Hishell/FileManager 1.0"]

			Method {
				name: "copy_file";
				Parameter { name: "source"; type: "string" }
				Parameter { name: "dest"; type: "string" }
			}

			Method {
				name: "duplicate_file";
				Parameter { name: "source"; type: "string" }
			}

			Method {
				name: "new_folder";
				Parameter { name: "parent"; type: "string" }
			}

			Method {
				name: "new_text_file";
				Parameter { name: "parent"; type: "string" }
			}

			Method {
				name: "create_link";
				Parameter { name: "source"; type: "string" }
				Parameter { name: "dest"; type: "string" }
			}

			Method {
				name: "trash_file";
				Parameter { name: "path"; type: "string" }
			}

			Method {
				name: "delete_file";
				Parameter { name: "path"; type: "string" }
			}

			Method {
				name: "rename_file";
				Parameter { name: "path"; type: "string" }
				Parameter { name: "new_name"; type: "string" }
			}

			Method {
				name: "copy_paths_to_clipboard";
				Parameter { name: "paths_newline"; type: "string" }
			}

			Method {
				name: "cut_paths_to_clipboard";
				Parameter { name: "paths_newline"; type: "string" }
			}

			Method {
				name: "paste_from_clipboard";
				Parameter { name: "dest_dir"; type: "string" }
			}

			Method {
				name: "get_mime_type";
				Parameter { name: "path"; type: "string" }
			}

			Method {
				name: "get_text_content";
				Parameter { name: "path"; type: "string" }
			}

			Method {
				name: "process_uris_action";
				Parameter { name: "dest_dir"; type: "string" }
				Parameter { name: "uris_newline"; type: "string" }
				Parameter { name: "action"; type: "string" }
			}
	}

	Component {
		name: "DragDropHandler"
		defaultProperty: "data"
			prototype: "QObject"
			exports: ["Hishell/DragDropHandler 1.0"]

			Property { name: "drag_action"; type: "string" }
			Property { name: "drag_cursor_x"; type: "double" }
			Property { name: "drag_cursor_y"; type: "double" }
			Property { name: "tooltip_active"; type: "bool" }
			Property { name: "active_dragged_paths"; type: "variant" }
			Property { name: "drag_icon_width"; type: "double" }
			Property { name: "drag_icon_height"; type: "double" }
			Property { name: "drag_uris"; type: "variant" }
			Property { name: "drag_source_paths"; type: "variant" }
			Property { name: "item_count"; type: "int" }
			Property { name: "file_title"; type: "string" }
			Property { name: "file_icon"; type: "string" }
			Property { name: "dragged_slot"; type: "variant" }

			Signal { name: "drag_action_changed" }
			Signal { name: "drag_cursor_changed" }
			Signal { name: "tooltip_active_changed" }
			Signal { name: "active_dragged_paths_changed" }

			Method {
				name: "track_mouse_shake";
				Parameter { name: "x"; type: "double" }
				Parameter { name: "y"; type: "double" }
			}

			Method {
				name: "cycle_drag_action";
			}

			Method {
				name: "reset";
			}

			Method {
				name: "set_drag_data";
				Parameter { name: "main_path"; type: "string" }
				Parameter { name: "uris"; type: "variant" }
				Parameter { name: "source_paths"; type: "variant" }
				Parameter { name: "item_count"; type: "int" }
				Parameter { name: "file_title"; type: "string" }
				Parameter { name: "file_icon"; type: "string" }
			}

			Method {
				name: "begin_drag";
				Parameter { name: "image_url"; type: "string" }
				Parameter { name: "width"; type: "double" }
				Parameter { name: "height"; type: "double" }
			}

			Method {
				name: "end_drag";
			}
	}

	Component {
		name: "DropValidator"
		defaultProperty: "data"
			prototype: "QObject"
			exports: ["Hishell/DropValidator 1.0"]

			Method {
				name: "is_drop_valid";
				Parameter { name: "target_path"; type: "string" }
				Parameter { name: "source_paths"; type: "variant" }
			}
	}

	Component {
		name: "PathUtils"
		defaultProperty: "data"
			prototype: "QObject"
			exports: ["Hishell/PathUtils 1.0"]

			Method {
				name: "get_segments";
				Parameter { name: "path"; type: "string" }
			}

			Method {
				name: "path_for_index";
				Parameter { name: "current_path"; type: "string" }
				Parameter { name: "idx"; type: "int" }
			}

			Method {
				name: "folder_name";
				Parameter { name: "path"; type: "string" }
			}

			Method {
				name: "normalize_path";
				Parameter { name: "path"; type: "string" }
			}

			Method {
				name: "parent_path";
				Parameter { name: "path"; type: "string" }
			}
	}

	Component {
		name: "SelectionManager"
		defaultProperty: "data"
			prototype: "QObject"
			exports: ["Hishell/SelectionManager 1.0"]

			Property { name: "selection_active"; type: "bool" }
			Property { name: "selected_paths"; type: "variant" }
			Property { name: "selected_count"; type: "int" }
			Property { name: "last_selected_index"; type: "int" }
			Property { name: "window"; type: "variant" }

			Signal { name: "selection_changed" }

			Method {
				name: "enter_selection_mode";
			}

			Method {
				name: "exit_selection_mode";
			}

			Method {
				name: "toggle_selection";
				Parameter { name: "path"; type: "string" }
				Parameter { name: "idx"; type: "int" }
			}

			Method {
				name: "range_select";
				Parameter { name: "from_idx"; type: "int" }
				Parameter { name: "to_idx"; type: "int" }
			}

			Method {
				name: "select_all";
			}

			Method {
				name: "deselect_all";
			}

			Method {
				name: "get_selected_path_list";
			}

			Method {
				name: "clear";
			}
	}
}