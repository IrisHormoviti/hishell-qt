#! /bin/sh
#
# rgkeyd - global volume / power / back-hotkey daemon for the RG DS Plus.
# The stock OS only handles these keys inside its launcher, so an app in the
# foreground loses them. See rgkeyd.c.
#
DAEMON=/opt/hishell/rgkeyd
LOG=/var/log/rgkeyd.log

start() {
	[ -x "$DAEMON" ] || exit 0
	pgrep -x rgkeyd >/dev/null 2>&1 && exit 0
	printf "Starting rgkeyd: "
	"$DAEMON" >>"$LOG" 2>&1 &
	echo "OK"
}

stop() {
	printf "Stopping rgkeyd: "
	killall rgkeyd 2>/dev/null
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

exit 0
